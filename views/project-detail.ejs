<%- include('partials/header') %>

<!-- Breadcrumbs & Mini Header -->
<div class="pt-32 pb-8 bg-slate-50 border-b border-gray-100 px-6 lg:px-12">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
                <a href="/works" class="hover:text-teal-600 transition-colors">Works</a>
                <span>/</span>
                <span class="text-slate-900 font-semibold">ShopSync Platform</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight">ShopSync Platform</h1>
        </div>
        <div class="flex gap-4">
            <div class="text-right">
                <span class="block text-xs text-gray-400 font-bold uppercase tracking-widest mb-1">Client</span>
                <span class="font-semibold text-slate-800">PT. Retailindo Global</span>
            </div>
            <div class="text-right pl-4 border-l border-gray-200">
                <span class="block text-xs text-gray-400 font-bold uppercase tracking-widest mb-1">Timeline</span>
                <span class="font-semibold text-slate-800">4 Bulan</span>
            </div>
        </div>
    </div>
</div>

<!-- Hero Mockup Section -->
<section class="py-16 bg-slate-50 overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-6 relative z-10" data-aos="fade-up">
        <!-- Floating decorative elements -->
        <div class="absolute top-10 left-10 w-32 h-32 bg-teal-500/10 rounded-full blur-[40px]"></div>
        <div class="absolute bottom-10 right-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-[60px]"></div>

        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/50 bg-white group">
            <!-- Simulated Browser/Window Header -->
            <div class="h-8 bg-slate-100 border-b border-slate-200 flex items-center px-4 gap-2">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <!-- Main Hero Image -->
            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1600&auto=format&fit=crop" alt="ShopSync Hero Dashboard" class="w-full h-auto object-cover max-h-[70vh] group-hover:scale-[1.02] transition-transform duration-700" />
        </div>
    </div>
</section>

<!-- Before & After / Challenge & Solution -->
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- The Challenge -->
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 text-red-600 rounded-full text-xs font-bold uppercase tracking-widest mb-6">
                    <i data-lucide="alert-circle" class="w-4 h-4"></i> Kondisi Sebelumnya
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 leading-tight">Proses manual yang rentan human-error dan tidak <span class="italic">scalable</span>.</h3>
                <p class="text-slate-500 leading-relaxed mb-6">Sebelum berkolaborasi dengan kami, klien menghadapi masalah serius dalam sinkronisasi inventaris antar berbagai <span class="italic">marketplace</span> (Shopee, Tokopedia, TikTok Shop). Staf harus mengupdate stok secara manual puluhan kali sehari yang sering berujung pada <span class="italic">overselling</span>, komplain pelanggan, dan inefisiensi operasional skala besar.</p>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3 text-slate-600"><i data-lucide="x-circle" class="w-5 h-5 text-red-400 mt-0.5"></i> Update stok sangat lambat (rata-rata delay 4 jam).</li>
                    <li class="flex items-start gap-3 text-slate-600"><i data-lucide="x-circle" class="w-5 h-5 text-red-400 mt-0.5"></i> Kehilangan potensi penjualan Rp 50Jt/bulan akibat error.</li>
                </ul>
            </div>

            <!-- The Solution (Impact) -->
            <div class="bg-slate-50 rounded-[2rem] p-8 md:p-12 border border-slate-100 relative overflow-hidden" data-aos="fade-left">
                <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-teal-500/10 rounded-full blur-[30px]"></div>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-teal-50 text-teal-600 rounded-full text-xs font-bold uppercase tracking-widest mb-6 relative z-10">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i> Solusi & Dampak
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 leading-tight relative z-10">Otomatisasi 100% dengan eksekusi milidetik.</h3>
                <p class="text-slate-500 leading-relaxed mb-8 relative z-10">Kami merekayasa ulang arsitektur sistem dari nol menggunakan pola <span class="italic">Event-Driven</span> dan <span class="italic">Queueing System</span> canggih. Hasilnya? Dasbor SaaS <span class="italic">real-time</span> yang menghubungkan seluruh toko dalam satu antarmuka.</p>
                
                <div class="grid grid-cols-2 gap-6 relative z-10">
                    <div>
                        <div class="text-4xl font-black text-teal-600 mb-1">99<span class="text-2xl">%</span></div>
                        <div class="text-sm text-slate-500 font-semibold uppercase tracking-wider">Penurunan Error</div>
                    </div>
                    <div>
                        <div class="text-4xl font-black text-teal-600 mb-1">0.5<span class="text-2xl">s</span></div>
                        <div class="text-sm text-slate-500 font-semibold uppercase tracking-wider">Kecepatan Sync</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- UI Gallery & Features -->
<section class="py-20 bg-slate-900 text-white relative overflow-hidden">
    <!-- Dark abstract background -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-[0.03]"></div>
    
    <div class="max-w-6xl mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-block px-4 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-teal-400 font-bold text-xs uppercase tracking-widest mb-4">Eksplorasi Fitur</span>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight">Detail UI & Fungsionalitas</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <!-- Feature 1 -->
            <div class="bg-slate-800/50 rounded-[2rem] border border-slate-700 p-8 group hover:bg-slate-800 transition-colors" data-aos="fade-up">
                <div class="w-12 h-12 bg-teal-500/20 text-teal-400 rounded-2xl flex items-center justify-center mb-6">
                    <i data-lucide="bar-chart-3" class="w-6 h-6"></i>
                </div>
                <h4 class="text-xl font-bold mb-3">Analitik Interaktif</h4>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">Visualisasi data penjualan dan tren pasar dengan grafik yang dinamis dan dapat difilter secara <span class="italic">real-time</span> tanpa jeda *loading*.</p>
                <div class="rounded-xl overflow-hidden border border-slate-700 aspect-video relative">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" />
                </div>
            </div>
            
            <!-- Feature 2 -->
            <div class="bg-slate-800/50 rounded-[2rem] border border-slate-700 p-8 group hover:bg-slate-800 transition-colors" data-aos="fade-up" data-aos-delay="100">
                <div class="w-12 h-12 bg-indigo-500/20 text-indigo-400 rounded-2xl flex items-center justify-center mb-6">
                    <i data-lucide="layers" class="w-6 h-6"></i>
                </div>
                <h4 class="text-xl font-bold mb-3">Manajemen Produk Massal</h4>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">Antarmuka tabel canggih (<span class="italic">DataGrid</span>) untuk memanipulasi ribuan data produk sekaligus dengan <span class="italic">user experience</span> semulus aplikasi desktop.</p>
                <div class="rounded-xl overflow-hidden border border-slate-700 aspect-video relative">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" />
                </div>
            </div>
        </div>
        
        <!-- Large Full Width Gallery -->
        <div class="rounded-[2rem] overflow-hidden border border-slate-700 relative group" data-aos="fade-up">
            <div class="absolute inset-0 bg-slate-900/50 opacity-0 group-hover:opacity-100 transition-opacity z-10 flex items-center justify-center backdrop-blur-sm">
                <div class="text-center">
                    <i data-lucide="maximize-2" class="w-10 h-10 text-white mx-auto mb-3 opacity-50"></i>
                    <p class="text-white font-bold tracking-widest uppercase">Responsive Mobile Layout</p>
                </div>
            </div>
            <img src="https://images.unsplash.com/photo-1512314889357-e157c22f938d?q=80&w=1200&auto=format&fit=crop" class="w-full h-[400px] object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
    </div>
</section>

<!-- Tech Stack Section -->
