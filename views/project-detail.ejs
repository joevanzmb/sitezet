            <div class="flex flex-col items-center gap-3 w-24">
                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-4xl text-[#47A248] hover:-translate-y-2 transition-transform cursor-help">
                    <i class="fas fa-database"></i>
                </div>
                <span class="text-xs font-bold text-slate-600">MongoDB</span>
            </div>
            <div class="flex flex-col items-center gap-3 w-24">
                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-4xl text-[#FF9900] hover:-translate-y-2 transition-transform cursor-help">
                    <i class="fab fa-aws"></i>
                </div>
                <span class="text-xs font-bold text-slate-600">AWS</span>
            </div>
            <div class="flex flex-col items-center gap-3 w-24">
