                            <div class="absolute inset-0 bg-gradient-to-r from-teal-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>
                            <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-teal-500/20 border border-teal-500/30 flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(20,184,166,0.2)] relative z-10 group-hover:scale-110 transition-transform duration-500">
