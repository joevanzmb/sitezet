            <script>
                const initPromoAnimations = () => {
                    const containers = document.querySelectorAll('.promo-container');
                    
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const container = entry.target;
                                if (container.dataset.animated === 'true') return;
                                container.dataset.animated = 'true';
                                
                                const badge = container.querySelector('.promo-badge');
                                const counter = container.querySelector('.promo-price-counter');
                                const initialLayout = container.querySelector('.promo-initial-layout');
                                const finalLayout = container.querySelector('.promo-final-layout');
                                
                                const targetValue = parseInt(container.dataset.targetValue);
                                
                                setTimeout(() => {
                                    let count = 0;
                                    const duration = 1200;
                                    const intervalTime = 30;
                                    const steps = duration / intervalTime;
                                    const increment = targetValue / steps;
                                    
                                    const interval = setInterval(() => {
                                        count += increment;
                                        if(count >= targetValue) {
                                            count = targetValue;
                                            clearInterval(interval);
                                            
                                            setTimeout(() => {
                                                initialLayout.classList.add('opacity-0', '-translate-y-4', 'scale-95');
                                                finalLayout.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                                                badge.classList.remove('opacity-0', 'translate-y-4', 'scale-90');
                                            }, 300);
                                        }
                                        
                                        if(count <= targetValue && counter) {
                                            if(count < 1000) {
                                                counter.innerText = Math.floor(count) + 'rb';
                                            } else {
                                                let jtValue = (count / 1000).toFixed(1).replace('.0', '').replace('.', ',');
                                                counter.innerText = jtValue + ' Jt';
                                            }
                                        }
                                    }, intervalTime);
                                }, 500); // Trigger animation slightly after coming into view
                            }
                        });
                    }, { threshold: 0.5 });
                    
                    containers.forEach(c => observer.observe(c));
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initPromoAnimations);
                } else {
                    initPromoAnimations();
                }
            </script>


