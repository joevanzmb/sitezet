                    class="absolute inset-y-0 right-0 w-48 sm:w-[600px] bg-gradient-to-l from-white via-white/90 to-transparent z-10 pointer-events-none">
                </div>
            </div>
            <!-- iPhone Style Strip -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-32 sm:w-56 h-1.5 bg-gray-200 rounded-full"></div>
        </section>
