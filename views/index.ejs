                    class="card-appear group relative h-[110px] [&.is-expanded]:h-[240px] lg:h-auto lg:flex-1 outline-none lg:hover:flex-[4] transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-[2.5rem] overflow-hidden cursor-pointer bg-white border border-slate-200 shadow-sm hover:shadow-xl [&.is-expanded]:shadow-xl hover:shadow-teal-900/5 [&.is-expanded]:shadow-teal-900/5"
