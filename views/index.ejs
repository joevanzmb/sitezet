            /* 1. Compass: Needle Spin */
            @keyframes needle-spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }

            .lucide-compass *:last-child {
                transform-origin: 50% 50%;
                transform-box: fill-box;
                animation: needle-spin 2s cubic-bezier(0.68, -0.55, 0.26, 1.55) infinite;
            }

            /* 2. File Code: Typing Brackets */
            @keyframes bracket-left {

                0%,
                100% {
                    transform: translateX(0);
                }

                50% {
                    transform: translateX(-3px);
                }
            }

            @keyframes bracket-right {

                0%,
                100% {
                    transform: translateX(0);
                }

                50% {
                    transform: translateX(3px);
                }
            }

            .lucide-file-code-2 path:nth-of-type(3) {
                animation: bracket-left 1.5s ease-in-out infinite;
            }

            .lucide-file-code-2 path:nth-of-type(4) {
                animation: bracket-right 1.5s ease-in-out infinite;
            }

            /* 3. Rocket: Rumble */
            @keyframes rocket-rumble {

                0%,
                100% {
                    transform: translate(0, 0) rotate(0deg);
                }

                25% {
                    transform: translate(-1px, -1px) rotate(-1deg);
                }

                50% {
                    transform: translate(1px, -0.5px) rotate(1deg);
                }

                75% {
                    transform: translate(-0.5px, 0) rotate(-0.5deg);
                }
            }

            .lucide-rocket {
                animation: rocket-rumble 0.2s linear infinite;
            }

            /* 4. Shield Check: Draw Checkmark */
            @keyframes check-draw-loop {

                0%,
                20% {
                    stroke-dashoffset: 30;
                    opacity: 0;
                }

                40%,
                80% {
                    stroke-dashoffset: 0;
                    opacity: 1;
                }

                100% {
                    stroke-dashoffset: 30;
                    opacity: 0;
                }
            }

            .lucide-shield-check path:nth-of-type(2) {
                stroke-dasharray: 30;
                animation: check-draw-loop 3s ease-in-out infinite;
            }

            @keyframes shield-pulse {

                0%,
                100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.05);
                }
            }

            .lucide-shield-check path:nth-of-type(1) {
                transform-origin: center;
                animation: shield-pulse 2s ease-in-out infinite;
            }

            /* 5. CPU: Active Processor Blink */
            @keyframes core-blink {

                0%,
                15%,
                50%,
                65%,
                100% {
                    fill: transparent;
                    opacity: 1;
                }

                5%,
                25%,
                35%,
                55%,
                80%,
                90% {
                    fill: currentColor;
                    opacity: 0.8;
                }
            }

            .lucide-cpu rect:last-of-type {
                animation: core-blink 2s step-end infinite;
            }

            /* 6. Activity: Drawing Signal Line */
            @keyframes signal-draw {
                0% {
                    stroke-dashoffset: 60;
                    opacity: 0;
                }

                5% {
                    opacity: 1;
                }

                60% {
                    stroke-dashoffset: 0;
                    opacity: 1;
                }

                80% {
                    stroke-dashoffset: 0;
                    opacity: 1;
                }

                100% {
                    stroke-dashoffset: 0;
                    opacity: 0;
                }
            }

            .lucide-activity path,
            .lucide-activity polyline {
                stroke-dasharray: 60;
                stroke-dashoffset: 60;
                animation: signal-draw 3s ease-out infinite;
            }

            /* 7. Terminal Typing Effect */
            .typewriter {
                display: inline-block;
                overflow: hidden;
                white-space: nowrap;
                width: 0;
                border-right: 2px solid transparent;
                vertical-align: bottom;
            }

            .group\/card.aos-animate .typewriter {
                animation:
                    typing 1.5s steps(var(--chars)) forwards,
                    typing-blink 0.75s step-end infinite;
            }

            @keyframes typing {
                to {
                    width: calc(var(--chars) * 1ch + 1ch);
                }
            }

            @keyframes typing-blink {

                0%,
                100% {
                    border-color: transparent;
                }

                50% {
                    border-color: currentColor;
                }
            }

            .terminal-output {
                opacity: 0;
                transform: translateY(4px);
            }

            .group\/card.aos-animate .terminal-output {
                animation: output-loop 4s ease-out infinite;
                animation-delay: 1.5s;
            }

            @keyframes output-loop {

                0%,
                10% {
                    opacity: 0;
                    transform: translateY(4px);
                }

                20%,
                80% {
                    opacity: 1;
                    transform: translateY(0);
                }

                90%,
                100% {
                    opacity: 0;
                    transform: translateY(-4px);
                }
            }
