                            <div class="w-2.5 h-2.5 md:w-3 md:h-3 bg-teal-400 rounded-full animate-bounce" style="animation-duration: 1s; animation-delay: 0s;"></div>
                            <div class="w-2.5 h-2.5 md:w-3 md:h-3 bg-teal-400 rounded-full animate-bounce" style="animation-duration: 1s; animation-delay: 0.15s;"></div>
