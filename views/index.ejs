                    class="fade-lang text-center text-xs font-bold tracking-widest uppercase text-gray-400">Trusted by
                    innovative companies worldwide</p>
            </div>
            <div class="relative flex overflow-x-hidden py-4">
                <!-- Left Gradient Vignette (Massive) -->
                <div
                    class="absolute inset-y-0 left-0 w-48 sm:w-[600px] bg-gradient-to-r from-white via-white/90 to-transparent z-10 pointer-events-none">
                </div>

                <!-- First Marquee Set -->
                <div class="animate-marquee flex items-center space-x-8 sm:space-x-12 pr-8 sm:pr-12 min-w-max">
                    <% if (typeof logos !=='undefined' && logos.length> 0) { %>
                        <% for (let i=0; i < 2; i++) { /* Internal Duplication for wide screens */ %>
                            <% logos.forEach(function(logo) { %>
                                <span class="text-xl sm:text-2xl font-bold flex items-center gap-3">
                                    <% if (logo.imageUrl) { %>
                                        <img src="<%= logo.imageUrl %>" alt="<%= logo.name %>"
                                            class="h-14 sm:h-16 w-auto object-contain transition-all duration-300">
                                        <% } else { %>
                                            <i data-lucide="hexagon" class="w-6 h-6 text-teal-500"></i>
                                            <%= logo.name %>
                                                <% } %>
                                </span>
                                <% }); %>
                                    <% } %>
                                        <% } %>
                </div>

                <!-- Second Marquee Set (Exact Duplicate of First for Seamless Loop) -->
                <div class="animate-marquee flex items-center space-x-8 sm:space-x-12 pr-8 sm:pr-12 min-w-max"
                    aria-hidden="true">
                    <% if (typeof logos !=='undefined' && logos.length> 0) { %>
