            <style>
                @keyframes pulseGlow {

                    0%,
                    100% {
                        filter: drop-shadow(0 0 8px rgba(13, 148, 136, 0.4));
                    }

                    50% {
                        filter: drop-shadow(0 0 25px rgba(13, 148, 136, 0.9));
                    }
                }

                .animate-pulse-glow {
                    animation: pulseGlow 3s ease-in-out infinite;
                    display: inline-block;
                }

                @keyframes pen-wiggle {
                    0%, 100% { transform: rotate(0deg) translate(0, 0); }
                    25% { transform: rotate(-10deg) translate(-2px, 2px); }
                    75% { transform: rotate(10deg) translate(2px, -2px); }
                }
                .lucide-pen-tool { animation: pen-wiggle 2s ease-in-out infinite; transform-origin: bottom left; }

                @keyframes buoy-float {
                    0%, 100% { transform: translateY(0) rotate(-5deg); }
                    50% { transform: translateY(-5px) rotate(5deg); }
                }
                .lucide-life-buoy { animation: buoy-float 3s ease-in-out infinite; transform-origin: center; }

                @keyframes wallet-pulse {
                    0%, 100% { transform: scale(1) rotate(0deg); }
                    15% { transform: scale(1.15) rotate(-5deg); }
                    30% { transform: scale(1) rotate(0deg); }
                }
                .lucide-wallet { animation: wallet-pulse 2.5s ease-in-out infinite; transform-origin: center; }
                .typing-text {
                    clip-path: inset(0 100% 0 0);
                }
                .aos-animate .typing-text {
                    animation: type-clip 1.5s steps(22, end) forwards;
                    animation-delay: 0.2s;
                }
                .typing-cursor {
                    position: absolute;
                    top: 10%;
                    bottom: 10%;
                    width: 6px;
                    background-color: #0d9488;
                    left: 0;
                    opacity: 0;
                }
                .aos-animate .typing-cursor {
                    animation: cursor-move 1.5s steps(22, end) forwards, blink-cursor 0.5s step-end 3 forwards;
                    animation-delay: 0.2s;
                }
                .ai-loading-bubble {
                    opacity: 0;
                    transform: translateY(10px) scale(0.9);
                    transform-origin: top left;
                    pointer-events: none;
                }
                .aos-animate .ai-loading-bubble {
                    animation: loading-pop 1.5s forwards;
                    animation-delay: 1.7s;
                }
                @keyframes loading-pop {
                    0% { opacity: 0; transform: translateY(10px) scale(0.9); }
                    10% { opacity: 1; transform: translateY(0) scale(1); }
                    90% { opacity: 1; transform: translateY(0) scale(1); }
                    100% { opacity: 0; transform: translateY(-10px) scale(0.9); }
                }
                .ai-response-animate {
                    opacity: 0;
                    transform: translateY(20px) scale(0.95);
                    transform-origin: top left;
                    visibility: hidden;
                }
                .aos-animate .ai-response-animate {
                    animation: popup-fade 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
                    animation-delay: 3.1s;
                }
                @keyframes popup-fade {
                    to { opacity: 1; transform: translateY(0) scale(1); visibility: visible; }
                }
                .card-appear {
                    opacity: 0;
                    transform: translateY(40px);
                    visibility: hidden;
                }
                .aos-animate .card-appear {
                    animation: 
                        card-pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                        card-flash 1.5s ease-out;
                }
                @keyframes card-pop {
                    to { opacity: 1; transform: translateY(0); visibility: visible; }
                }
                @keyframes card-flash {
                    0% { border-color: #e2e8f0; box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
                    20% { border-color: #14b8a6; box-shadow: 0 0 30px rgba(20,184,166,0.5); }
                    100% { border-color: #e2e8f0; box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
                }
                @keyframes type-clip {
                    0% { clip-path: inset(0 100% 0 0); }
                    100% { clip-path: inset(0 -5% 0 0); }
                }
                @keyframes cursor-move {
                    0% { left: 0%; opacity: 1; }
                    100% { left: 100%; opacity: 1; }
                }
                @keyframes blink-cursor {
                    0%, 100% { opacity: 0; }
                    50% { opacity: 1; }
                }
            </style>
            <!-- Ambient Glow to prevent flatness -->
            <div class="absolute left-1/2 top-16 -translate-x-1/2 w-[80%] max-w-[800px] h-[300px] bg-teal-400/20 rounded-full blur-[80px] pointer-events-none z-0"></div>

            <div class="flex flex-col w-full max-w-5xl mx-auto mb-16 md:mb-24 relative z-10 px-4 lg:px-0" data-aos="fade-up">
                
