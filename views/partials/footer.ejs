    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Typed.js initialization moved to main.js (setLang)

            // Set active navigation links dynamically
            const currentPath = window.location.pathname;
            const isHome = currentPath === '/' || currentPath.endsWith('index.html');
            
            document.querySelectorAll('.desktop-nav-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href && ((isHome && href === 'index.html') || (!isHome && href !== 'index.html' && currentPath.includes(href.replace('.html', ''))))) {
                    link.classList.remove('text-gray-500');
                    link.classList.add('text-teal-600', 'font-bold');
                }
            });

            document.querySelectorAll('.mobile-nav-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href && ((isHome && href === 'index.html') || (!isHome && href !== 'index.html' && currentPath.includes(href.replace('.html', ''))))) {
                    link.classList.remove('text-gray-500');
                    link.classList.add('text-teal-600', 'bg-teal-50/50');
                    const icon = link.querySelector('i');
                    if(icon) {
                        icon.classList.remove('text-gray-300');
                        icon.classList.add('text-teal-500');
                    }
                }
            });
        });

        // Accordion Interaction Logic
        function toggleAccordion(element, contentClass) {
            const content = element.querySelector('.' + contentClass);
            const iconWrapper = element.querySelector('.icon-wrapper');
            const isOpen = content.classList.contains('max-h-[500px]');

            // Optional: Close others in the same group (Uncomment to enable auto-collapse)
            /*
            const siblings = element.parentElement.children;
            for(let sibling of siblings) {
                if(sibling !== element && sibling.classList.contains(element.classList[0])) {
                    let sibContent = sibling.querySelector('.' + contentClass);
                    let sibIcon = sibling.querySelector('.icon-wrapper');
                    if(sibContent) {
                        sibContent.classList.remove('max-h-[500px]', 'opacity-100');
                        sibContent.classList.add('max-h-0', 'opacity-0');
                    }
                    if(sibIcon) sibIcon.style.transform = 'rotate(0deg)';
                }
            }
            */

            if (!isOpen) {
                // Open action
                content.classList.remove('max-h-0', 'opacity-0');
                content.classList.add('max-h-[500px]', 'opacity-100');
                // Rotate icon depending on the section type
                if (contentClass === 'faq-content') {
                    iconWrapper.style.transform = 'rotate(180deg)'; // Arrow flips up
                } else {
                    iconWrapper.style.transform = 'rotate(45deg)'; // Plus becomes X
                }
            } else {
                // Close action
                content.classList.remove('max-h-[500px]', 'opacity-100');
                content.classList.add('max-h-0', 'opacity-0');
                iconWrapper.style.transform = 'rotate(0deg)';
            }
        }
    </script>
