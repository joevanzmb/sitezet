    <!-- Prototype Logic Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Main System Tabs Switching
            const sysBtns = document.querySelectorAll('.sys-tab-btn');
            const sysViews = document.querySelectorAll('.sys-view');
            const macTitle = document.getElementById('mac-title');

            sysBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset buttons
                    sysBtns.forEach(b => {
                        b.classList.remove('active', 'border-teal-500', 'bg-teal-500/10');
                        b.classList.add('border-transparent', 'bg-slate-800/50');
                        const iconWrapper = b.querySelector('.rounded-xl');
                        iconWrapper.classList.remove('bg-teal-500', 'text-white');
                        iconWrapper.classList.add('bg-slate-700', 'text-slate-300');
                    });
                    // Set active button
                    btn.classList.add('active', 'border-teal-500', 'bg-teal-500/10');
                    btn.classList.remove('border-transparent', 'bg-slate-800/50');
                    const iconWrapper = btn.querySelector('.rounded-xl');
                    iconWrapper.classList.add('bg-teal-500', 'text-white');
                    iconWrapper.classList.remove('bg-slate-700', 'text-slate-300');

                    // Update title
                    macTitle.innerText = btn.getAttribute('data-title');

                    // Switch views with fade
                    const targetId = btn.getAttribute('data-target');
                    sysViews.forEach(view => {
                        view.style.opacity = '0';
                        setTimeout(() => {
                            view.classList.add('hidden');
                            if (view.id === targetId) {
                                view.classList.remove('hidden');
                                // small delay for display block to take effect before opacity transition
                                setTimeout(() => {
                                    view.style.opacity = '1';
                                }, 50);
                            }
                        }, 300); // Wait for fade out
                    });
                });
            });

            // COMPRO Inner Navigation
            const comproNavBtns = document.querySelectorAll('.compro-nav-btn');
            const comproViews = document.querySelectorAll('.compro-view');
            comproNavBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    comproNavBtns.forEach(b => {
                        b.classList.remove('text-teal-600');
                        b.classList.add('text-slate-500');
                    });
                    btn.classList.add('text-teal-600');
                    btn.classList.remove('text-slate-500');

                    const targetId = btn.getAttribute('data-view');
                    comproViews.forEach(view => {
                        if (view.id === targetId) {
                            view.style.opacity = '1';
                            view.style.transform = 'translateX(0)';
                            view.style.pointerEvents = 'auto';
                        } else {
                            view.style.opacity = '0';
                            view.style.transform = 'translateX(10px)';
                            view.style.pointerEvents = 'none';
                        }
                    });
                });
            });

            // LMS Inner Navigation
            const lmsRoleBtns = document.querySelectorAll('.lms-role-btn');
            const lmsPanels = document.querySelectorAll('.lms-panel');
            lmsRoleBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    lmsRoleBtns.forEach(b => {
                        b.classList.remove('bg-teal-500', 'text-white', 'shadow-sm', 'active');
                        b.classList.add('text-slate-400');
                    });
                    btn.classList.add('bg-teal-500', 'text-white', 'shadow-sm', 'active');
                    btn.classList.remove('text-slate-400');

                    const targetId = btn.getAttribute('data-role');
                    const isStudent = targetId === 'lms-student';
                    
                    const instructorPanel = document.getElementById('lms-instructor');
                    const studentPanel = document.getElementById('lms-student');

                    if (isStudent) {
                        instructorPanel.style.transform = 'translateX(-100%)';
                        studentPanel.style.transform = 'translateX(0)';
                    } else {
                        instructorPanel.style.transform = 'translateX(0)';
                        studentPanel.style.transform = 'translateX(100%)';
                    }
                });
            });
        });

        // E-COMMERCE Functions
        window.showEcomDetail = function() {
            const detailView = document.getElementById('ecom-detail');
            detailView.style.transform = 'translateX(0)';
        };
        window.hideEcomDetail = function() {
            const detailView = document.getElementById('ecom-detail');
            detailView.style.transform = 'translateX(100%)';
        };

        // POS Functions
        let posItems = [];
        window.addPosItem = function(name, price) {
            posItems.push({name, price});
            renderPos();
        };
        window.clearPos = function() {
            posItems = [];
            renderPos();
        };
        window.processPos = function() {
            if(posItems.length > 0) {
                const btn = document.querySelector('#sys-pos button.bg-teal-500');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Memproses...';
                setTimeout(() => {
                    btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Lunas';
                    btn.classList.remove('bg-teal-500', 'hover:bg-teal-600');
                    btn.classList.add('bg-emerald-500', 'hover:bg-emerald-600');
                    setTimeout(() => {
                        clearPos();
                        btn.innerHTML = originalHtml;
                        btn.classList.add('bg-teal-500', 'hover:bg-teal-600');
                        btn.classList.remove('bg-emerald-500', 'hover:bg-emerald-600');
                        if(window.lucide) lucide.createIcons();
                    }, 1500);
                }, 800);
            }
        };

        function renderPos() {
            const receipt = document.getElementById('pos-receipt');
            const subtotalEl = document.getElementById('pos-subtotal');
            const taxEl = document.getElementById('pos-tax');
            const totalEl = document.getElementById('pos-total');
            
            if(posItems.length === 0) {
                receipt.innerHTML = '<div class="text-center text-slate-400 text-xs italic mt-10" id="pos-empty">Belum ada pesanan</div>';
                subtotalEl.innerText = 'Rp 0';
                taxEl.innerText = 'Rp 0';
                totalEl.innerText = 'Rp 0';
                return;
            }

            receipt.innerHTML = '';
            let subtotal = 0;

            // Group items (simple)
            const counts = {};
            posItems.forEach(item => {
                if(!counts[item.name]) counts[item.name] = { price: item.price, count: 0 };
                counts[item.name].count++;
                subtotal += item.price;
            });

            for(let name in counts) {
                const data = counts[name];
                const div = document.createElement('div');
                div.className = 'flex justify-between items-start text-xs';
                div.innerHTML = `
                    <div class="flex-1">
                        <div class="font-bold text-slate-800">${name}</div>
                        <div class="text-slate-500">${data.count}x @ Rp ${(data.price/1000)}k</div>
                    </div>
                    <div class="font-bold text-slate-800">Rp ${(data.price * data.count / 1000)}k</div>
                `;
                receipt.appendChild(div);
            }

            const tax = Math.round(subtotal * 0.11);
            const total = subtotal + tax;

            const formatRp = (num) => new Intl.NumberFormat('id-ID').format(num);

            subtotalEl.innerText = 'Rp ' + formatRp(subtotal);
            taxEl.innerText = 'Rp ' + formatRp(tax);
            totalEl.innerText = 'Rp ' + formatRp(total);
        }

        // HRIS Functions
        const hrisNavBtns = document.querySelectorAll('.hris-nav-btn');
        const hrisViews = document.querySelectorAll('.hris-view');
        const hrisTitle = document.getElementById('hris-title');
        hrisNavBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                hrisNavBtns.forEach(b => {
                    b.classList.remove('bg-teal-50', 'text-teal-600', 'border-r-2', 'border-teal-500', 'active');
                    b.classList.add('text-slate-500');
                });
                btn.classList.add('bg-teal-50', 'text-teal-600', 'border-r-2', 'border-teal-500', 'active');
                btn.classList.remove('text-slate-500');
                
                hrisTitle.innerText = btn.innerText;

                const targetId = btn.getAttribute('data-view');
                hrisViews.forEach(view => {
                    if (view.id === targetId) {
                        view.style.opacity = '1';
                        view.style.transform = 'translateX(0)';
                        view.style.pointerEvents = 'auto';
                    } else {
                        view.style.opacity = '0';
                        view.style.transform = 'translateX(10px)';
                        view.style.pointerEvents = 'none';
                    }
                });
            });
        });

        // WMS Functions
        window.showBarcodeScanner = function() {
            const scanner = document.getElementById('wms-scanner');
            scanner.classList.remove('opacity-0', 'pointer-events-none');
        };
        window.hideBarcodeScanner = function() {
            const scanner = document.getElementById('wms-scanner');
