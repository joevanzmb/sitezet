    <!-- Estimator Logic Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const radiosType = document.querySelectorAll('input[name="project_type"]');
            const checkboxesFeature = document.querySelectorAll('input[name="feature"]');
            const radiosTimeline = document.querySelectorAll('input[name="timeline"]');
            
            const totalDisplay = document.getElementById('estimator-total');
            const summaryType = document.getElementById('summary-type');
            const summaryTimeline = document.getElementById('summary-timeline');
            const summaryContainer = document.getElementById('estimator-summary');
            const btnCta = document.getElementById('estimator-cta');

            // Format number to Rupiah
            const formatRp = (number) => {
                return new Intl.NumberFormat('id-ID').format(number);
            };

            const calculateTotal = () => {
                let basePrice = 0;
                let featuresPrice = 0;
                let timelineMultiplier = 1;

                let selectedTypeLabel = '';
                let selectedTimelineLabel = '';
                let selectedFeatures = [];

                // Get Project Type
                radiosType.forEach(radio => {
                    if (radio.checked) {
                        basePrice = parseInt(radio.value);
                        selectedTypeLabel = radio.getAttribute('data-label');
                    }
                });

                // Get Features
                checkboxesFeature.forEach(chk => {
                    if (chk.checked) {
                        featuresPrice += parseInt(chk.value);
                        selectedFeatures.push(chk.getAttribute('data-label'));
                    }
                });

                // Get Timeline Multiplier
                radiosTimeline.forEach(radio => {
                    if (radio.checked) {
                        timelineMultiplier = parseFloat(radio.value);
                        selectedTimelineLabel = radio.getAttribute('data-label');
                    }
                });

                // Calculate
                const subtotal = basePrice + featuresPrice;
                const total = Math.round(subtotal * timelineMultiplier);

                // Add animation effect to number
                totalDisplay.style.transform = 'scale(1.1) translateY(-2px)';
                totalDisplay.style.opacity = '0.5';
                totalDisplay.style.color = '#5eead4'; // teal-300
                
                setTimeout(() => {
                    totalDisplay.innerText = formatRp(total);
                    totalDisplay.style.transform = 'scale(1) translateY(0)';
                    totalDisplay.style.opacity = '1';
                    totalDisplay.style.color = '#ffffff';
                }, 200);

                // Update Summary UI
                summaryType.innerText = selectedTypeLabel;
                summaryTimeline.innerText = selectedTimelineLabel;
                
                // Clear existing dynamic feature lis
                const existingLis = summaryContainer.querySelectorAll('.feature-li');
                existingLis.forEach(li => li.remove());

                // Add selected features to summary
                selectedFeatures.forEach(feat => {
                    const li = document.createElement('li');
                    li.className = 'feature-li flex items-start gap-3';
                    li.innerHTML = `
                        <div class="bg-teal-500/20 p-1 rounded mt-0.5"><i data-lucide="plus" class="w-3 h-3 text-teal-400"></i></div> 
                        <span class="text-slate-300 leading-tight">${feat}</span>
                    `;
                    summaryContainer.appendChild(li);
                });

                // Re-init lucide icons for new elements
                if(window.lucide) {
                    lucide.createIcons();
                }

                // Update CTA Link
                const waNumber = '6281234567890'; // Ganti dengan nomor asli
                let waMessage = `Halo Sitezet, saya tertarik membuat *${selectedTypeLabel}*.\n\n`;
                if(selectedFeatures.length > 0){
                    waMessage += `Fitur Tambahan:\n- ${selectedFeatures.join('\n- ')}\n\n`;
                }
                waMessage += `Timeline Pengerjaan: *${selectedTimelineLabel}*\n`;
                waMessage += `Estimasi Biaya: *Rp ${formatRp(total)}*\n\n`;
                waMessage += `Mohon info lebih lanjut untuk memulai diskusi proyek ini. Terima kasih!`;
                
                btnCta.onclick = () => {
                    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`, '_blank');
                };
            };

            // Add Event Listeners
            radiosType.forEach(el => el.addEventListener('change', calculateTotal));
            checkboxesFeature.forEach(el => el.addEventListener('change', calculateTotal));
            radiosTimeline.forEach(el => el.addEventListener('change', calculateTotal));

            // Init calculation
            calculateTotal();
        });
    </script>


